enum Bar {
    aaa
}

struct Foo {
    a: i64,
    b: Bar,
}

func main() -> i64 {
    var a = 1
    // report
    if Foo { a : 1, b : Bar::aaa } {
        return a
    }
    // ok
    if (Foo { a : 1, b : Bar::aaa }) {
        return a
    }

    // report
    while Foo { a : 1, b : Bar::aaa } {
        return a
    }
    // ok
    while (Foo { a : 1, b : Bar::aaa }) {
        return a
    }

    // report
    match Foo { a : 1, b : Bar::aaa } {
        Bar::aaa => return a
        _ => return 0
    }
    // ok
    match (Foo { a : 1, b : Bar::aaa }) {
        Bar::aaa => return a
        _ => return 0
    }
    return 0
}